{
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "(www\\.)?tubegeny\\.com"
        }
      ],
      "destination": "/tubegeny.html"
    },
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "(www\\.)?lazygeny\\.com"
        }
      ],
      "destination": "/index.html"
    }
  ]
}
