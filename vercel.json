{
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "(?<subdomain>.*\\.)?tubegeny\\.com"
        }
      ],
      "destination": "/tubegeny"
    },
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "(?<subdomain>.*\\.)?lazygeny\\.com"
        }
      ],
      "destination": "/"
    }
  ]
}
